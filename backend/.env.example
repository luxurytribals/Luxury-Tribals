# ========================================
# LUXURY TRIBALS - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in all values
# DO NOT commit .env to git (it's in .gitignore)

# ========================================
# DATABASE
# ========================================
# Get from: https://cloud.mongodb.com
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/luxury-tribals?retryWrites=true&w=majority
MONGODB_URI=

# ========================================
# JWT (JSON Web Token)
# ========================================
# Generate a random secret (minimum 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ========================================
# ADMIN CREDENTIALS (for seeding database)
# ========================================
# These are used when you run: npm run seed
# Change the password after first login!
ADMIN_EMAIL=admin@luxurytribals.in
ADMIN_PASSWORD=ChangeMe123!

# ========================================
# RAZORPAY PAYMENT GATEWAY
# ========================================
# Get from: https://dashboard.razorpay.com/app/keys
# For testing: Use "Test Mode" keys (start with rzp_test_)
# For production: Use "Live Mode" keys (start with rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Get from: https://dashboard.razorpay.com/app/webhooks
# Create a webhook with URL: https://your-backend-url.com/api/payments/webhook
# Events to enable: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ========================================
# SHIPROCKET (Shipping Integration)
# ========================================
# Get from: https://app.shiprocket.in/seller/setting
# You need a Shiprocket account to get these credentials
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Your pickup location name in Shiprocket
# Must match the pickup location you created in Shiprocket dashboard
STORE_NAME=Luxury Tribals Primary Warehouse

# ========================================
# FRONTEND URL (for CORS)
# ========================================
# Local development:
# FRONTEND_URL=http://localhost:5501

# Production (GitHub Pages example):
# FRONTEND_URL=https://yourusername.github.io/luxury-tribals
FRONTEND_URL=http://localhost:5501

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=development

# When deploying to production, change NODE_ENV to:
# NODE_ENV=production
